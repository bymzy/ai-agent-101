<view class="page">
  <view class="section" wx:if="{{imagePath}}">
    <view class="section-title">图片标注</view>
    <view class="photo-wrap">
      <image class="photo" src="{{imagePath}}" mode="widthFix" bindload="onImageLoad" />
      <view
        wx:for="{{words}}"
        wx:key="word"
        wx:if="{{item.bbox}}"
        class="bbox"
        style="{{item.boxStyle}}"
      >
        <view class="bbox-label">{{item.word}}</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">识别到的单词</view>
    <view class="word-tip">点击单词可听发音</view>
    <view class="words">
      <view
        class="word-card {{wordPlayingIndex === index ? 'word-card-playing' : ''}}"
        wx:for="{{words}}"
        wx:key="word"
        data-index="{{index}}"
        bindtap="playWord"
      >
        <view
          class="word-star {{item.saved ? 'word-star-active' : ''}}"
          data-index="{{index}}"
          catchtap="toggleWordbook"
        >
          {{item.saved ? '★' : '☆'}}
        </view>
        <view class="word">{{item.word}}</view>
        <view wx:if="{{item.phonetic}}" class="word-phonetic">{{item.phonetic}}</view>
        <view class="word-translation">{{item.translation}}</view>
        <view class="word-category">{{item.category}}</view>
        <view class="word-play">
          {{wordLoadingIndex === index ? '合成中…' : wordPlayingIndex === index ? '播放中' : '点击发音'}}
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">{{langName}}句子</view>
    <view wx:if="{{sentence}}" class="sentence">{{sentence}}</view>
    <view wx:if="{{translation}}" class="sentence-translation">{{translation}}</view>
    <view wx:if="{{!sentence}}" class="placeholder">
      {{generating ? '正在生成句子…' : '正在准备句子…'}}
    </view>
    <view wx:if="{{recordState !== 'recorded'}}" class="actions">
      <button
        class="secondary-btn"
        disabled="{{!sentence || speaking}}"
        bindtap="toggleRecord"
      >
        {{recordState === 'recording' ? '停止录音' : '跟读'}}
      </button>
      <button
        class="primary-btn"
        loading="{{speaking}}"
        disabled="{{!sentence || speaking || recordState === 'recording'}}"
        bindtap="playSentence"
      >
        播放语音
      </button>
    </view>
    <view wx:if="{{recordState === 'recording'}}" class="record-hint">
      正在录音 {{recordSeconds}}s，点击「停止录音」结束
    </view>
    <view wx:if="{{recordState === 'recorded'}}" class="actions">
      <button class="secondary-btn" bindtap="playMyRecord">
        {{playingRecord ? '停止播放' : '播放我的录音'}}
      </button>
      <button
        class="primary-btn"
        loading="{{speaking}}"
        disabled="{{speaking}}"
        bindtap="playSentence"
      >
        播放语音
      </button>
    </view>
    <view wx:if="{{recordState === 'recorded'}}" class="record-links">
      <text class="record-link" bindtap="toggleRecord">重录</text>
      <text class="record-sep">·</text>
      <text class="record-link" bindtap="changeSentence">换一句</text>
    </view>
    <view wx:if="{{sentence && recordState === 'idle' && !generating}}" class="regenerate" bindtap="changeSentence">
      换一句
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view wx:if="{{error && !sentence}}" class="retry" bindtap="generateSentence">重试</view>
  </view>

  <button
    class="share-btn"
    loading="{{sharing}}"
    disabled="{{!sentence || sharing || !imagePath}}"
    bindtap="shareImage"
  >
    生成分享图
  </button>
  <view wx:if="{{!imagePath}}" class="share-hint">此结果没有原图，无法生成分享图</view>
  <view wx:elif="{{!sentence}}" class="share-hint">先生成句子再分享</view>

  <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>
</view>
