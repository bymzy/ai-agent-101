.empty {
  padding: 120rpx 40rpx;
  color: #a8adb5;
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.wb-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.wb-count {
  flex: 1;
  color: #4e5969;
  font-size: 26rpx;
}

.wb-start {
  width: 200rpx;
  margin: 0;
  padding: 12rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
}

.group {
  margin-bottom: 28rpx;
}

.group-title {
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.category {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.category-title {
  margin-bottom: 8rpx;
  color: #07c160;
  font-size: 24rpx;
}

.word-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.word-row:last-child {
  border-bottom: none;
}

.word-info {
  flex: 1;
  min-width: 0;
}

.word-head {
  display: flex;
  align-items: center;
}

.word-text {
  font-size: 32rpx;
  font-weight: 600;
}

.word-badge {
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #fdf3e3;
  color: #f5a623;
  font-size: 20rpx;
}

.word-phonetic {
  margin-top: 2rpx;
  color: #a8adb5;
  font-size: 22rpx;
}

.word-translation {
  margin-top: 4rpx;
  color: #8a9099;
  font-size: 24rpx;
}

.word-remove {
  margin-left: 20rpx;
  padding: 8rpx 16rpx;
  color: #e64340;
  font-size: 24rpx;
}
