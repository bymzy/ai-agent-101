.empty {
  padding: 120rpx 0;
  color: #a8adb5;
  font-size: 28rpx;
  text-align: center;
}

.record {
  display: flex;
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  margin-right: 24rpx;
  border-radius: 12rpx;
  background: #eef0f3;
  flex-shrink: 0;
}

.record-body {
  flex: 1;
  min-width: 0;
}

.record-meta {
  color: #8a9099;
  font-size: 24rpx;
}

.record-sentence {
  margin-top: 12rpx;
  color: #1f2329;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.record-actions {
  margin-top: 12rpx;
}

.record-recall {
  display: inline-block;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  background: #e8f8ee;
  color: #07c160;
  font-size: 24rpx;
}
