.empty {
  padding: 120rpx 40rpx;
  color: #a8adb5;
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.empty-link {
  margin-top: 24rpx;
  color: #07c160;
  font-size: 28rpx;
}

.review-progress {
  margin-bottom: 20rpx;
  color: #8a9099;
  font-size: 26rpx;
  text-align: center;
}

.review-hint {
  margin-bottom: 20rpx;
  color: #f5a623;
  font-size: 24rpx;
  text-align: center;
}

.review-card {
  padding: 48rpx 32rpx;
  border-radius: 20rpx;
  background: #ffffff;
  text-align: center;
}

.review-word {
  font-size: 56rpx;
  font-weight: 700;
  word-break: break-all;
}

.review-phonetic {
  margin-top: 8rpx;
  color: #a8adb5;
  font-size: 28rpx;
}

.review-meaning {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.5;
}

.review-ask {
  margin-top: 24rpx;
  color: #8a9099;
  font-size: 26rpx;
}

.review-listen {
  padding: 32rpx 0;
  border-radius: 16rpx;
  background: #e8f8ee;
  color: #07c160;
  font-size: 32rpx;
  font-weight: 600;
}

.review-options {
  margin-top: 32rpx;
}

.review-option {
  margin-top: 16rpx;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
  color: #1f2329;
  font-size: 30rpx;
}

.review-option-right {
  background: #e8f8ee;
  color: #07c160;
  font-weight: 600;
}

.review-option-wrong {
  background: #fdecec;
  color: #e64340;
}

.review-btn {
  margin-top: 24rpx;
}

.review-grade {
  display: flex;
  margin-top: 32rpx;
}

.review-grade-btn {
  flex: 1;
}

.review-grade-btn + .review-grade-btn {
  margin-left: 20rpx;
}

.review-score {
  margin: 24rpx 0;
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
}

.review-lapsed {
  margin-bottom: 24rpx;
  color: #8a9099;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

.review-lapsed-word {
  color: #f5a623;
}
